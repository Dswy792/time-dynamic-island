#include <windows.h>
#include "resource.h"

// ---------------------------------------------------------------------------
// Application icon
// ---------------------------------------------------------------------------
IDI_APP_ICON ICON "app.ico"

// ---------------------------------------------------------------------------
// Application manifest (Per-Monitor V2 DPI awareness, asInvoker)
// ---------------------------------------------------------------------------
1 RT_MANIFEST "app.manifest"

// ---------------------------------------------------------------------------
// Version information
// ---------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 5,2,2,0
 PRODUCTVERSION 5,2,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Dynamic Island"
            VALUE "FileDescription", "Dynamic Island - desktop clock capsule with message notifications"
            VALUE "FileVersion", "5.2.2.0"
            VALUE "InternalName", "DynamicIsland"
            VALUE "LegalCopyright", "Copyright (c) 2026 Dynamic Island contributors"
            VALUE "OriginalFilename", "DynamicIsland.exe"
            VALUE "ProductName", "Dynamic Island"
            VALUE "ProductVersion", "5.2.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
